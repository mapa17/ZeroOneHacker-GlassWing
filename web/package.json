{
  "name": "uniqa-coach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/agent/coach.test.mjs src/agent/adapter.test.mjs && python -m pytest ../coach/tests/",
    "sim:personas": "node scripts/run-tests.mjs",
    "sim:agent": "node scripts/run-agent-tests.mjs",
    "validate:benchmarks": "node scripts/validate-benchmarks.mjs",
    "persona:gen": "node scripts/persona-generator.mjs",
    "persona:prompts": "node scripts/generate-system-prompts.mjs",
    "agent:interactive": "node scripts/run-interactive-agent.mjs",
    "agent:analyze": "node scripts/analyze-interactive-sessions.mjs",
    "export:zip": "bash scripts/export-package.sh"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
