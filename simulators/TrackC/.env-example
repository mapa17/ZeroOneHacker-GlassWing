# Copy to .env and fill in your key:
#   cp .env.example .env
#
# Required for interactive agent, system-prompt generation, and --gpt enrichment.

OPENAI_API_KEY=

# Model used by the customer simulation (CLI interactive agent)
CUSTOMER_MODEL=gpt-5.4-mini

# Model used by the coach (CLI + web via Vite proxy)
COACH_MODEL=gpt-5.4-mini
VITE_COACH_MODEL=gpt-5.4-mini
